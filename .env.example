# GeoHarvest environment configuration template
# Copy to .env and fill in real values. Never commit .env to Git.

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug

# ── AI Services (backend only — never put these in Flutter) ────────────────
# OpenAI — enables LLM-powered Kofi AI responses
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# GhanaNLP — enables real ASR (speech-to-text) and TTS (text-to-speech)
GHANANLP_API_KEY=your_ghananlp_api_key_here
GHANANLP_BASE_URL=https://translation-api.ghananlp.org

# ── Mock services (set to false in production) ─────────────────────────────
USE_MOCK_SERVICES=true

# ── Backend server ─────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
BACKEND_API_VERSION=v1

# ── CORS (comma-separated list of allowed origins) ────────────────────────
# Leave empty in development to use localhost defaults
# In production: CORS_ORIGINS=https://app.geoharvest.com,https://api.geoharvest.com
CORS_ORIGINS=

# ── Database ───────────────────────────────────────────────────────────────
# postgresql+asyncpg://user:password@localhost:5432/geoharvest
DATABASE_URL=
DB_POOL_SIZE=10
DB_ECHO=false

# ── Authentication ─────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINS=60
